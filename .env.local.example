# Salin file ini menjadi .env.local lalu isi dengan data proyek Supabase kamu
# (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-dengan-anon-public-key

# --- Analisis AI (opsional, KHUSUS SERVER: jangan diberi awalan NEXT_PUBLIC_) ---
# Tanpa kunci ini, ramalan dan rekomendasi berbasis aturan tetap berjalan; hanya penjelasan LLM yang nonaktif.
ANTHROPIC_API_KEY=
# Model LLM (ganti sesuai model yang tersedia di akunmu)
LLM_MODEL=claude-haiku-5-5
# Batas penjelasan AI per admin per hari (pengendali biaya)
AI_DAILY_LIMIT=20
